DB_HOST=localhost
DB_NAME=kuragedb
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
STEAM_API_KEY=
FRONTEND_URL=http://localhost:3000
FRONTEND_ADDITIONAL_ORIGINS=
BACKEND_URL=http://127.0.0.1:8080
# Recommended: leave blank so auth cookies remain host-only on the API domain.
COOKIE_DOMAIN=
API_DOMAIN=api.example.com

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Development only. Generate a unique high-entropy value for every environment.
JWT_SECRET=replace-with-at-least-32-random-bytes

FACEIT_API_KEY=
FACEIT_CACHE_DURATION=300000

# Game Server Heartbeat API Key. Use an independent random value of at least 32 bytes.
GAME_SERVER_API_KEY=
GAME_SERVER_BOOTSTRAP_ENABLED=false
FIXED_SERVER_ID=b1a2c3d4-0000-0000-0000-000000000001
FIXED_SERVER_DISPLAY_NAME=Kurage Retake #1
FIXED_SERVER_HOSTNAME=127.0.0.1
FIXED_SERVER_PORT=27015
FIXED_SERVER_MAX_PLAYERS=10

# Cloudflare R2 (opcional). The S3 endpoint never includes the bucket name.
# For production, connect a public custom domain directly to the bucket and
# use that domain below; do not use the frontend application URL.
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=kurage
CLOUDFLARE_R2_PUBLIC_URL=https://assets.example.com
