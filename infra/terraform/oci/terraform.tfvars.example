tenancy_ocid             = "ocid1.tenancy.oc1..replace-me"
compartment_ocid         = "ocid1.compartment.oc1..replace-me"
region                   = "sa-saopaulo-1"
availability_domain_index = 0
ssh_public_key           = "ssh-ed25519 AAAA... github-actions-kurage"
ssh_allowed_cidr         = "203.0.113.10/32"
# GitHub-hosted runner IPs are dynamic. Keep true for the prepared CI/CD model;
# switch to false after adopting a private runner or outbound-only tunnel.
allow_github_hosted_ssh_deploy = true

instance_ocpus       = 2
instance_memory_gb   = 6
boot_volume_size_gb = 50

api_domain      = "api.caiomayan.com"
frontend_domain = "kurage.caiomayan.com"
