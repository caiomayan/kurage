# Vercel Production environment for kurage.caiomayan.com.
NEXT_PUBLIC_APP_URL=https://kurage.caiomayan.com
NEXT_PUBLIC_API_URL=https://api.caiomayan.com

# Leave blank for web-only alpha. Set the real host:port when public Retake is ready.
NEXT_PUBLIC_CS2_CONNECT_HOST=

# Public custom domain connected directly to the Cloudflare R2 bucket.
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.caiomayan.com

# Optional origin-bound partner key issued by 3d.cstrike.app.
NEXT_PUBLIC_CS2_VIEWER_KEY=
